library(mrgsolve)
options(repos = c(CRAN = "https://cloud.r-project.org"))
library(mrgsolve)
library(dplyr)
mod <- mread("pk3cmt", modlib())
read(mod)
mod
param(mod)
init(mod)
see(mod)
mod <- mod %>% param(#
  CL = 15,    # L/h, total body clearance
)
see(mod)
mod <- mod %>% param(CL = 15)
param(mod)["CL"]
mod <- mod %>% param(CL = 50, VC = 3.5, Q = 8, VP = 10, Q2 = 2, VP2=20 KA1=0.195, KA2=6.02736, KM-5.57)
mod <- mod %>% param(CL = 50, VC = 3.5, Q = 8, VP = 10, Q2 = 2, VP2=20 KA1=0.195, KA2=6.02736, KM=5.57)
mod <- mod %>% param(CL = 50, VC = 3.5, Q = 8, VP = 10, Q2 = 2, VP2=20, KA1=0.195, KA2=6.02736, KM=5.57)
sim_data <- mod %>%#
    ev(amt = 400, cmt = 2) %>% # dose into compartment 2#
    mrgsim(end = 48, delta = 0.5)
plot()
head(sim_data)
write.csv(as.data.frame(sim_data), "simulation_output_fluorouracil.csv", row.names = FALSE)
param(mod)
sim_data <- mod %>%#
    ev(amt = 400, cmt = 2) %>% # dose into compartment 2#
    mrgsim(end = 24, delta = 0.2)
write.csv(as.data.frame(sim_data), "simulation_output_fluorouracil.csv", row.names = FALSE)
