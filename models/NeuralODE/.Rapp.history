library(mrgsolve)
library(dplyr)
mod <- mread("pk2", modlib())
mod
init(mod)
see(mod)
mod %>% mrgsim()
mod %>%#
    ev(amt = 100, cmt = 2) %>% #
    mrgsim(end = 24, delta = 0.2) %>%#
    plot()
mod %>%#
+     ev(amt = 50, cmt = 2) %>% #
+     mrgsim(end = 24, delta = 0.2) %>%#
+     plot()
mod %>%#
    ev(amt = 50, cmt = 2) %>% #
    mrgsim(end = 24, delta = 0.2) %>%#
    plot()
mod %>%#
    ev(amt = 100, cmt = 2) %>% #
    mrgsim(end = 24, delta = 0.2) %>%#
    plot()
mod %>%#
    ev(amt = 80, cmt = 2) %>% #
    mrgsim(end = 24, delta = 0.2) %>%#
    plot()
mod %>%#
    ev(amt = 100, cmt = 2) %>% # bolus dosing every 12 hours for 10 doses#
    mrgsim(end = 48, delta = 0.5) %>% # simulate for 24 hours#
    plot()
